# Default mode is an isolated local demo. Set postgres to use your farm database.
APP_MODE=demo
DATABASE_URL=postgresql+psycopg://fishfarm:replace-me@localhost:5432/fishfarm
POSTGRES_PASSWORD=replace-me

# APP_MODE=postgres
# DATABASE_URL = "postgresql+psycopg://sme-fish-farm-app:db_smefishfarm1@34.35.28.190:5432/sme-fish-farm-app?sslmode=require"
# POSTGRES_PASSWORD=db_smefishfarm1

# Secure by default. Use demo ONLY for local synthetic-data evaluation.
AUTH_MODE=oidc


# Inference server; chat is disabled until a model is configured.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=
# For compatible endpoints, include /v1 in the base URL and use HTTPS remotely.
LLM_API_KEY=

# Client display name for this deployment, e.g. Sekom Farms. Restart after changing.
CLIENT_NAME= Sekom Farms
