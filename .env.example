# Default mode is an isolated local demo. Set postgres to use your farm database.
APP_MODE=demo
DATABASE_URL=postgresql+psycopg://fishfarm:replace-me@localhost:5432/fishfarm
POSTGRES_PASSWORD=replace-me

# Secure by default. Use demo ONLY for local synthetic-data evaluation.
AUTH_MODE=oidc

# Inference server; chat is disabled until a model is configured.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=
# For compatible endpoints, include /v1 in the base URL and use HTTPS remotely.
LLM_API_KEY=
